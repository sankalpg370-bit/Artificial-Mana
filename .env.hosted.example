# Vercel + Supabase. Set these before building; NEXT_PUBLIC values are bundled.
NEXT_PUBLIC_BACKEND=supabase
NEXT_PUBLIC_LOCAL_ONLY=0
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://www.artificialmana.com
APP_ORIGIN=https://www.artificialmana.com
# Server-only management gate; never prefix this with NEXT_PUBLIC.
ADMIN_TEMP_ACCESS_KEY=

# Guest learning is open to everyone; enable only after configuring email delivery.
NEXT_PUBLIC_ALLOW_SIGNUP=0
