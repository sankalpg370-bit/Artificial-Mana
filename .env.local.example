# Windows: Copy-Item .env.local.example .env.local
# Local test first; change both URLs to your real HTTPS address before public use.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep database/files outside the code folder. Use forward slashes on Windows.
# Example: DATA_DIR=C:/ArtificialManaData
# Empty uses the ignored .data folder inside this project.
DATA_DIR=

# Required by the existing management portal gate. Generate a random key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TEMP_ACCESS_KEY=

# Optional: stop new registrations while retaining existing account login.
DISABLE_SIGNUP=0

# Browser-only demo; leave 0 for accounts and the local server database.
NEXT_PUBLIC_LOCAL_ONLY=0
